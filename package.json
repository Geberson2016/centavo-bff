{
  "name": "centavo-bff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "contract:sync": "cp ${BACKEND_SPEC:-../centavo-backend/src/main/resources/openapi.yaml} contracts/backend.openapi.yaml",
    "api:generate": "openapi-typescript contracts/backend.openapi.yaml -o src/backend/schema.ts --export-type && openapi-typescript openapi.yaml -o src/contract/schema.ts --export-type --enum-values",
    "api:check": "npm run contract:sync && npm run api:generate && git diff --exit-code -- contracts src/backend/schema.ts src/contract/schema.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
