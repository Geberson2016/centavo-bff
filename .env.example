# Copie para .env e ajuste. Todas têm padrão; só sobrescreva o que precisar.
NODE_ENV=development
# Em container use 0.0.0.0
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# URL base da API Spring (sem /api/v1). Local: docker compose em ~/Projects/Centavo
BACKEND_URL=http://localhost:8090
# Timeout de cada chamada ao Spring, em ms
BACKEND_TIMEOUT_MS=10000
# Chave que cifra o cookie de sessão: 32 bytes em hex. Gere com: openssl rand -hex 32
# Obrigatória. Trocar a chave derruba todas as sessões abertas.
SESSION_KEY=
# Cookie só por HTTPS. Padrão: true em produção, false fora dela.
# SESSION_COOKIE_SECURE=true
